{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project": {
    "appName": "CISA Studio",
    "appId": "com.cisastudio.app",
    "versionName": "1.0.0",
    "versionCode": 100,
    "description": "CISA Studio - Generador Inteligente de Tareas Académicas Basado en Rúbricas",
    "author": "bbaakkuu-svg",
    "license": "MIT"
  },
  "paths": {
    "webSourceDir": "../dist",
    "mobileProjectDir": "../cisa-mobile",
    "androidDir": "../cisa-mobile/android",
    "outputDir": "./output",
    "distDir": "../dist"
  },
  "capacitor": {
    "coreVersion": "^8.5.0",
    "androidVersion": "^8.5.0",
    "cliVersion": "^8.5.0",
    "serverScheme": "https",
    "cleartext": false,
    "splashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0f172a",
      "showSpinner": false
    },
    "statusBar": {
      "style": "DARK",
      "backgroundColor": "#0f172a"
    }
  },
  "android": {
    "minSdkVersion": 24,
    "compileSdkVersion": 36,
    "targetSdkVersion": 36,
    "androidxAppCompatVersion": "1.7.1",
    "androidxCoordinatorLayoutVersion": "1.3.0",
    "coreSplashScreenVersion": "1.2.0"
  },
  "signing": {
    "keystoreFile": "cisastudio-release.keystore",
    "keyAlias": "cisastudio",
    "storePassword": "cisastudio123",
    "keyPassword": "cisastudio123",
    "validityDays": 10000,
    "keyAlgorithm": "RSA",
    "keySize": 2048,
    "dname": "CN=CISAStudio, OU=Education, O=CISA Studio Inc, L=Madrid, ST=Madrid, C=ES",
    "v1SigningEnabled": true,
    "v2SigningEnabled": true
  }
}
