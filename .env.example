# Configuración de Supabase (Backend & DB)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anonima_publica_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role_privada_aqui

# Motor de IA / LLM (Opcional si se ejecuta desde Edge Functions o API)
VITE_AI_PROVIDER=gemini # gemini, openai, anthropic
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Entorno de Aplicación
VITE_APP_ENV=development
VITE_APP_NAME="CISA Studio"
VITE_APP_VERSION=1.0.0
