{
  "name": "cisa-studio",
  "private": true,
  "version": "1.0.0",
  "description": "CISA Studio - Generador Inteligente de Tareas Académicas Basado en Rúbricas",
  "author": "bbaakkuu-svg",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "canvas-confetti": "^1.9.4",
    "docx": "^9.2.0",
    "exceljs": "^4.4.0",
    "jspdf": "^2.5.2",
    "lucide-react": "^1.16.0",
    "pptxgenjs": "^3.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^40.8.0",
    "electron-builder": "^26.7.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.cisastudio.desktop",
    "productName": "CISA Studio",
    "copyright": "Copyright © 2026 bbaakkuu-svg",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/cisa-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CISA Studio",
      "installerIcon": "public/cisa-icon.ico",
      "uninstallerIcon": "public/cisa-icon.ico",
      "installerHeaderIcon": "public/cisa-icon.ico",
      "artifactName": "CISA_Studio_Setup_${version}.${ext}"
    }
  }
}
